{
  "manifest_version": 3,
  "name": "YBA Goal Alignment Engine",
  "version": "1.1",
  "description": "YouTube Behavioral Analytics & Goal Alignment Engine extension for real-time focus shielding and telemetry.",
  "permissions": ["storage", "tabs", "history"],

  "host_permissions": ["*://*.youtube.com/*", "http://localhost:8000/*", "http://localhost:5173/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YBA Goal Alignment Engine"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["dashboard-sync.js"],
      "run_at": "document_start"
    }
  ]
}
